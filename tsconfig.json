{
    "compilerOptions": {
      "target": "ES2022",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "strict": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "types": ["node"],
      "skipLibCheck": true,
      "outDir": "./dist"
    },
    "include": [
      "src/**/*.ts",
      "features/**/*.ts"
    ]
  }